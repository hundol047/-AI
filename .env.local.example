# OpenAI API key (server-side only, never exposed to the client)
# Used for Root Cause Analysis, the Plan step, and the Result step's final
# answer, all via the Vercel AI SDK. If left empty, TraceAgent automatically
# falls back to rule-based / templated mock output so the demo still works
# end-to-end without a key.
OPENAI_API_KEY=

# Tavily Search API key (server-side only, never exposed to the client)
# https://tavily.com — used by the Search and Tool Call steps for real web
# search and real page-content extraction. If left empty, TraceAgent falls
# back to a fully simulated Search/Tool Call pipeline (the original demo
# behavior), so the app still runs with zero external setup.
TAVILY_API_KEY=

# Supabase project credentials.
# If left empty, TraceAgent automatically falls back to an in-memory data store
# so the app still runs locally without a Supabase project.
# NEXT_PUBLIC_SUPABASE_URL is also accepted as plain SUPABASE_URL (some
# Vercel<->Supabase integrations provision it under that name instead).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is not currently used by the server — it's
# only here for future client-side Supabase usage; safe to leave empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

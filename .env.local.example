# OpenAI API key (server-side only, never exposed to the client)
# Used by /api/runs/[id]/analyze for Root Cause Analysis via the Vercel AI SDK.
# If left empty, TraceAgent automatically falls back to a rule-based mock analyzer
# so the demo still works end-to-end without a key.
OPENAI_API_KEY=

# Supabase project credentials.
# If left empty, TraceAgent automatically falls back to an in-memory data store
# so the app still runs locally without a Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
